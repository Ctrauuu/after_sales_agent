# 苏宁业务数据库
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# 身份凭证防重放
REDIS_URL=redis://127.0.0.1:6380/0

# Hermes RBAC 桥接签名（两端必须一致，密钥至少 32 字节）
SUNING_MCP_BRIDGE_SECRET=
SUNING_IDENTITY_ISSUER=suning-feishu-primary
SUNING_AUTHN_REQUIRE_REDIS=true

# 订单全链路：聚合服务及其四个下游私有 MCP 地址、整体超时
SUNING_MCP_ORDER_URL=http://127.0.0.1:8101/mcp
SUNING_MCP_AFTERSALE_URL=http://127.0.0.1:8102/mcp
SUNING_MCP_LOGISTICS_URL=http://127.0.0.1:8104/mcp
SUNING_MCP_PAYMENT_URL=http://127.0.0.1:8105/mcp
SUNING_MCP_TIMELINE_URL=http://127.0.0.1:8106/mcp
ORDER_TIMELINE_TIMEOUT_SECONDS=10

# MCP/LLM 调用链路：默认发送至本机 OTel Collector；未启动 Collector 不影响业务调用
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces

# NL2SQL、槽位提取与会话摘要 / DeepSeek（统一由 LangChain create_model 工厂创建）
DEEPSEEK_API=
# 也可使用 DEEPSEEK_API_KEY；两者存在时优先读取 DEEPSEEK_API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
NL2SQL_TIMEOUT_SECONDS=30

# Hermes 上下文 Hooks
CONTEXT_LLM_TIMEOUT_SECONDS=15
CONTEXT_SLOT_CONFIDENCE_THRESHOLD=0.7
CONTEXT_WHITELIST_TTL_SECONDS=300

# 多 IM 图表：飞书使用应用凭据；企微复用 Hermes 已连接的 AI Bot WebSocket。
# 钉钉当前 Hermes 会话 Webhook 不支持图片上传，将自动降级为文字摘要。
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 长期记忆：SQLite/FTS5 + DashScope Embedding + Milvus
DASHSCOPE_API_KEY=
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=memory_vectors
MILVUS_TIMEOUT_SECONDS=5
MEMORY_DB_PATH=~/.hermes/state/suning_business_memory.db
MEMORY_EMBEDDING_MODEL=text-embedding-v3
MEMORY_EMBEDDING_TIMEOUT_SECONDS=10
LONG_MEMORY_MIN_CONFIDENCE=0.7
LONG_MEMORY_TOP_K=3
LONG_MEMORY_HALF_LIFE_DAYS=30
LONG_MEMORY_LLM_TIMEOUT_SECONDS=20

# Agent Skill 自进化：复用 DashScope Embedding；未配置密钥时自动不启用
SKILL_EVOLUTION_ENABLED=true
# 留空时写入项目 .hermes/skills/evolved；独立部署可配置绝对目录
SKILL_EVOLUTION_DIR=
SKILL_EVOLUTION_EMBEDDING_MODEL=text-embedding-v3
SKILL_EVOLUTION_EMBEDDING_TIMEOUT_SECONDS=10

# 售后知识库 RAG：与长期记忆共用 DashScope/Milvus 服务，但使用独立 collection
KNOWLEDGE_MILVUS_COLLECTION=knowledge_chunks
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-v3
KNOWLEDGE_TIMEOUT_SECONDS=10
KNOWLEDGE_TOP_K=3
